# Copy this file to .env and fill in the keys you have access to.
# You only need a key for the provider(s) you actually enable.

GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
XAI_API_KEY=your_xai_key_here

# Comma-separated list of origins allowed to call this API (your frontend URL)
ALLOWED_ORIGINS=http://localhost:5173
